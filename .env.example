# Krypton LLM FinOps Observability Gateway Environment Configuration

# Google Gemini API Key (Required only if USE_LIVE_GEMINI=true)
GEMINI_API_KEY=""

# Mode Toggle: Set to true for live Gemini API calls, false for zero-latency simulated provider
USE_LIVE_GEMINI="false"
SIMULATED_LATENCY_MS=45

# MongoDB Atlas Connection (Optional - falls back to in-memory ledger if omitted or unreachable)
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app_name>"
DATABASE_NAME="krypton_gateway"

# Pricing Table Configuration (Optional - defaults to backend/data/pricing.json)
PRICING_FILE="backend/data/pricing.json"

# Redis Connection (Optional - falls back to in-memory store)
REDIS_URL="redis://localhost:6379/0"
